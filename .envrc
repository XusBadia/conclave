# Carga los secretos descifrando en memoria.
#
# No usa la funcion 'dotenv' de direnv a proposito: registra el temporal en su
# lista de vigilancia y, al borrarlo, direnv recarga en cada prompt.
#
# Tampoco hace 'set -a; . fichero': el sourcing aplica expansion del shell y
# eso pierde valores en silencio. Casos reales vistos en estos repos:
#   - un '&' sin comillas parte la asignacion (las URL de Postgres con
#     ?sslmode=require&channel_binding=require perdian su variable y creaban
#     una fantasma llamada channel_binding)
#   - un espacio antes del '=' convierte la linea en un comando
#   - '$' y backtick se expandirian dentro de comillas dobles
#
# En su lugar parsea cada linea con semantica dotenv y exporta el valor citado
# con shlex.quote, literal por construccion.
watch_file .env.enc
watch_file .env.local.enc

_ENC_PARSER="$(cat <<'PYEOF'
import sys, shlex, re

ESCAPABLES = '"\\$`'


def valor(v):
    """Extrae el valor con semantica dotenv: comillas envolventes opcionales,
    y comentario inline descartado."""
    v = v.lstrip()
    if v[:1] in ('"', "'"):
        q, i, buf = v[0], 1, []
        while i < len(v):
            c = v[i]
            # Entre comillas dobles el shell reconoce estos escapes.
            if q == '"' and c == "\\" and i + 1 < len(v) and v[i + 1] in ESCAPABLES:
                buf.append(v[i + 1]); i += 2; continue
            if c == q:
                break
            buf.append(c); i += 1
        return "".join(buf)
    # Sin comillas: ' #' inicia comentario inline.
    return re.split(r"\s#", v, 1)[0].rstrip()


for raw in sys.stdin:
    line = raw.rstrip("\n")
    if not line.strip() or line.lstrip().startswith("#"):
        continue
    if "=" not in line:
        continue
    k, v = line.split("=", 1)
    k = k.strip()
    if k.startswith("export "):
        k = k[len("export "):].strip()
    if not k or not (k[0].isalpha() or k[0] == "_"):
        continue
    if not all(c.isalnum() or c == "_" for c in k):
        continue
    print("export " + k + "=" + shlex.quote(valor(v)))
PYEOF
)"

_load_enc() {
  [ -f "$1" ] || return 0
  local _out
  if ! _out="$(sops -d --input-type dotenv --output-type dotenv "$1" 2>/dev/null \
                | python3 -c "$_ENC_PARSER" 2>/dev/null)"; then
    log_status "no he podido descifrar $1"
    return 0
  fi
  eval "$_out"
}

_load_enc .env.enc
_load_enc .env.local.enc
